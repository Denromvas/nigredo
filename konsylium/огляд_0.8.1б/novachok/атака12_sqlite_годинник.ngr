← спробап Λ назва пара » ＋ ＋ назва 「: 」 ☂ σ 🜔бд.писати б § пара 0 § пара 1 λе ＋ 「✗ 」 ⊏ е 0 100
спроба 「1 strftime без часу」 「UPDATE т SET а=а WHERE а < CAST(strftime('%S') AS INTEGER)」
спроба 「2 julianday()」 「UPDATE т SET а=а WHERE а < CAST((julianday()*86400) AS INTEGER) % 60」
спроба 「3 unixepoch()」 「UPDATE т SET а=а WHERE а < unixepoch() % 60」
спроба 「4 CURRENT_TIMESTAMP」 「UPDATE т SET а=а WHERE а < CAST(substr(CURRENT_TIMESTAMP,18,2) AS INTEGER)」
спроба 「5 'NOW'」 「UPDATE т SET а=а WHERE а < CAST(strftime('%S','NOW') AS INTEGER)」
спроба 「6 'n'||'ow'」 「UPDATE т SET а=а WHERE а < CAST(strftime('%S','n'||'ow') AS INTEGER)」
спробап 「7 параметр now」 【「UPDATE т SET а=а WHERE а < CAST(strftime('%S',?1) AS INTEGER)」 【「now」】】
спроба 「8 now з таблиці」 「UPDATE т SET а=а WHERE а < CAST(strftime('%S',(SELECT v FROM s)) AS INTEGER)」
спроба 「9 date('now') з датою」 「UPDATE т SET а=а WHERE а < CAST(strftime('%S','2026-01-01 00:00:17') AS INTEGER)」
спроба 「10а DEFAULT CURRENT_TIMESTAMP — таблиця」 「CREATE TABLE IF NOT EXISTS д1 (x, t DEFAULT CURRENT_TIMESTAMP)」
спроба 「10б DEFAULT CURRENT_TIMESTAMP — вставка」 「INSERT INTO д1 (x) VALUES (1)」
спроба 「10в DEFAULT CURRENT_TIMESTAMP — витік」 「UPDATE т SET а=а WHERE а < (SELECT CAST(substr(t,18,2) AS INTEGER) FROM д1 ORDER BY rowid DESC LIMIT 1)」
спроба 「11а DEFAULT (datetime('now'))」 「CREATE TABLE IF NOT EXISTS д2 (x, t DEFAULT (strftime('%S','now')))」
спроба 「11б вставка」 「INSERT INTO д2 (x) VALUES (1)」
спроба 「11в витік」 「UPDATE т SET а=а WHERE а < (SELECT CAST(t AS INTEGER) FROM д2 ORDER BY rowid DESC LIMIT 1)」
спроба 「12а DEFAULT (random())」 「CREATE TABLE IF NOT EXISTS д3 (x, r DEFAULT (random()))」
спроба 「12б вставка」 「INSERT INTO д3 (x) VALUES (1)」
спроба 「12в витік」 「UPDATE т SET а=а WHERE а < (SELECT abs(r) % 60 FROM д3 ORDER BY rowid DESC LIMIT 1)」
спроба 「13а тригер」 「CREATE TRIGGER IF NOT EXISTS тр AFTER INSERT ON s BEGIN INSERT INTO д1 (x, t) VALUES (2, strftime('%Y-%m-%d %H:%M:%S','now')); END」
спроба 「13б тригер — вставка」 「INSERT INTO s VALUES ('x')」
спроба 「14а VIEW」 「CREATE VIEW IF NOT EXISTS вид AS SELECT CAST(strftime('%S','now') AS INTEGER) AS с」
спроба 「14б VIEW — витік」 「UPDATE т SET а=а WHERE а < (SELECT с FROM вид)」
спроба 「15 randomblob(1)」 「UPDATE т SET а=а WHERE а < unicode(randomblob(1)) % 60」
спроба 「16 ORDER BY random()」 「UPDATE т SET а=а WHERE а < (SELECT а FROM т ORDER BY random() LIMIT 1)」
спроба 「17 UPSERT CURRENT_TIME」 「INSERT INTO д1 (rowid, x) VALUES (1, 3) ON CONFLICT(rowid) DO UPDATE SET t = CURRENT_TIME」
спроба 「18 datetime('now','start of day')」 「UPDATE т SET а=а WHERE а < CAST(strftime('%d','now','start of day') AS INTEGER)」
спроба 「19 timediff」 「UPDATE т SET а=а WHERE а < CAST(substr(timediff('now','2000-01-01'),19,2) AS INTEGER)」
спроба 「20 julianday('now ')」 「UPDATE т SET а=а WHERE а < CAST(strftime('%S',' now') AS INTEGER)」
» 「кінець」
