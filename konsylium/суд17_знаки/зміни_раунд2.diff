+def nfc(s):
+    """NFC рядка за час, близький до лінійного. unicodedata.normalize упорядковує низку знаків поєднання вставками:
+    100 000 знаків двох класів упереміш — секунди, мільйон — хвилини, а кроки ζ платить за розмір (суд 17: Скептик,
+    Мовознавець, Аудитор, Оркестратор). Тож довгі низки впорядковуємо самі (стійке сортування за класом — це і є
+    канонічний порядок; рядок лишається канонічно рівним собі), а normalize дістає вже впорядковане. Символ із
+    класом 0, що розкладається на самі знаки поєднання (U+0F73 → U+0F71 U+0F72), — теж частина низки."""
+    if s.isascii():
+        return s
+    if len(s) > 64:
+        comb, out, last, start, run = unicodedata.combining, [], 0, -1, []
+        for i, ch in enumerate(s):
+            if ch < '\u0300':
+                d = ''
+            else:
+                d = _NFC_RUN.get(ch)
+                if d is None:
+                    d = unicodedata.normalize('NFD', ch)
+                    d = _NFC_RUN[ch] = d if all(comb(c) for c in d) else ''
+            if d:
+                if start < 0:
+                    start = i
+                run.append(d)
+            elif start >= 0:
+                if i - start > 8:
+                    out.append(s[last:start])
+                    out.append(''.join(sorted(''.join(run), key=comb)))
+                    last = i
+                start, run = -1, []
+        if start >= 0 and len(s) - start > 8:
+            out.append(s[last:start])
+            out.append(''.join(sorted(''.join(run), key=comb)))
+            last = len(s)
+        if last:
+            out.append(s[last:])
+            s = ''.join(out)
+    return unicodedata.normalize('NFC', s)
+
