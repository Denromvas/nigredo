» з 「CREATE TRIGGER тр4 BEFORE INSERT ON т4 BEGIN SELECT CASE WHEN CAST(strftime('%S', 'now') AS INTEGER) % 2 = 1 THEN RAISE(ABORT, 'непарна') END; END」
